{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "webviews": [
    "main"
  ],
  "permissions": [
    "allow-check-frontend-bundle-update",
    "allow-set-app-exit-handler-ready",
    "allow-complete-app-exit",
    "allow-request-app-exit",
    "allow-map-view-request",
    "allow-map-view-set-bounds",
    "allow-map-view-close",
    "allow-map-view-open",
    "allow-cancel-app-exit",
    "allow-inspect-legacy-webkit-origin",
    "allow-quarantine-legacy-webkit-origin",
    "allow-download-and-install-resumable-update",
    "allow-get-app-distribution-channel",
    "core:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPLOCALDATA/**" },
        { "path": "$APPDATA/**" },
        { "path": "$APPCONFIG/**" }
      ]
    },
    "updater:default",
    "store:default",
    "dialog:default",
    "process:allow-restart",
    "clipboard-manager:allow-clear",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-html",
    "clipboard-manager:allow-write-image",
    "clipboard-manager:allow-write-text",
    "notification:default",
    "shell:allow-open"
  ]
}
