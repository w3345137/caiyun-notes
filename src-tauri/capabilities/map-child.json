{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "map-child",
  "description": "Allows only validated replies from isolated map webviews",
  "webviews": ["map-session-*"],
  "remote": {
    "urls": [
      "caiyun-map-probe://localhost/runtime.html*",
      "http://caiyun-map-probe.localhost/runtime.html*"
    ]
  },
  "permissions": ["allow-map-view-reply"]
}
