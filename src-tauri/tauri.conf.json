{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "彩云笔记",
  "version": "10.2.3",
  "identifier": "com.caiyun.notes",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "create": false,
        "label": "main",
        "title": "",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": false,
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: data: https://notes.binapp.top; connect-src 'self' blob: https://notes.binapp.top wss://notes.binapp.top https://restapi.amap.com https://webapi.amap.com https://gitee.com https://github.com https://api.github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com; frame-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "app", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "./Info.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "devtools": false,
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://gitee.com/binbin3344/cloudnote/raw/master/updates/latest.json",
        "https://notes.binapp.top/updates/latest.json",
        "https://github.com/w3345137/caiyun-notes/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxNzI5OEQ3M0M5MjYyQzEKUldUQllwSTgxNWh5d1JKQ3p3dFJOcTNxRmdIZHBNY2F0WDJaVVczRWh5SHR1b0ZVL2Y4eVNkUEcK"
    }
  }
}
