{
  "name": "caiyun-notes-tauri-shell",
  "private": true,
  "version": "10.2.8",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "build": "tauri build",
    "build:debug": "tauri build --debug --no-bundle",
    "build:msstore": "node scripts/with-store-capabilities.mjs --features frontend-hot-update",
    "build:msstore:no-hotupdate": "node scripts/with-store-capabilities.mjs",
    "build:appstore": "node scripts/with-store-capabilities.mjs --config src-tauri/tauri.appstore.conf.json --features frontend-hot-update",
    "build:appstore:no-hotupdate": "node scripts/with-store-capabilities.mjs --config src-tauri/tauri.appstore.conf.json",
    "pack:msix": "powershell -ExecutionPolicy Bypass -File scripts/pack-msix.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.2",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@tauri-apps/plugin-store": "2.4.2",
    "@tauri-apps/plugin-updater": "2.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1"
  }
}
